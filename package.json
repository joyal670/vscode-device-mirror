{
  "name": "vscode-device-mirror",
  "displayName": "Device Mirror",
  "description": "Mirror and control a connected Android device inside VS Code.",
  "version": "0.0.1",
  "publisher": "joyal670",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "deviceMirror.start",
        "title": "Start Mirroring",
        "category": "Device Mirror",
        "icon": "$(device-mobile)"
      },
      {
        "command": "deviceMirror.stop",
        "title": "Stop Mirroring",
        "category": "Device Mirror",
        "icon": "$(debug-stop)"
      },
      {
        "command": "deviceMirror.screenshot",
        "title": "Take Screenshot",
        "category": "Device Mirror",
        "icon": "$(device-camera)"
      },
      {
        "command": "deviceMirror.toggleRecording",
        "title": "Start/Stop Screen Recording",
        "category": "Device Mirror",
        "icon": "$(record)"
      },
      {
        "command": "deviceMirror.installApk",
        "title": "Install APK on Device…",
        "category": "Device Mirror",
        "icon": "$(package)"
      },
      {
        "command": "deviceMirror.pushFile",
        "title": "Push File to Device…",
        "category": "Device Mirror",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "deviceMirror.pairWifi",
        "title": "Pair Device over Wi-Fi…",
        "category": "Device Mirror",
        "icon": "$(key)"
      },
      {
        "command": "deviceMirror.connectWifi",
        "title": "Connect to Device over Wi-Fi…",
        "category": "Device Mirror",
        "icon": "$(plug)"
      },
      {
        "command": "deviceMirror.switchToWifi",
        "title": "Switch USB Device to Wi-Fi",
        "category": "Device Mirror",
        "icon": "$(radio-tower)"
      },
      {
        "command": "deviceMirror.refreshDevices",
        "title": "Refresh Devices",
        "category": "Device Mirror",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Device Mirror",
      "properties": {
        "deviceMirror.adbPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to adb. Leave empty to auto-detect from ANDROID_HOME, the default SDK location, or PATH."
        },
        "deviceMirror.mode": {
          "type": "string",
          "enum": [
            "scrcpy",
            "screencap"
          ],
          "enumDescriptions": [
            "Real-time H.264 mirroring with input. Requires server/scrcpy-server.jar.",
            "Low-framerate screenshot polling. No input. Needs nothing but adb."
          ],
          "default": "scrcpy",
          "description": "Capture backend."
        },
        "deviceMirror.maxSize": {
          "type": "number",
          "default": 1024,
          "description": "Longest edge of the streamed video, in pixels. Lower is faster."
        },
        "deviceMirror.maxFps": {
          "type": "number",
          "default": 30,
          "description": "Capture framerate cap."
        },
        "deviceMirror.videoBitRate": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Video bit rate in bits per second (e.g. 8000000). 0 uses the scrcpy default (8 Mbps)."
        },
        "deviceMirror.audio": {
          "type": "boolean",
          "default": false,
          "description": "Forward device audio (Android 11+). Sent as uncompressed PCM (~1.5 Mbps). Click the mirror once to allow playback."
        },
        "deviceMirror.stayAwake": {
          "type": "boolean",
          "default": false,
          "description": "Keep the device awake while it is being mirrored over USB."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "deviceMirror.devices",
          "name": "Android Devices",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deviceMirror.devices",
        "contents": "No Android devices found.\nConnect one over USB with USB debugging enabled, or pair one over Wi-Fi.\n[Pair over Wi-Fi](command:deviceMirror.pairWifi)\n[Connect over Wi-Fi](command:deviceMirror.connectWifi)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deviceMirror.pairWifi",
          "when": "view == deviceMirror.devices",
          "group": "navigation@1"
        },
        {
          "command": "deviceMirror.refreshDevices",
          "when": "view == deviceMirror.devices",
          "group": "navigation@2"
        },
        {
          "command": "deviceMirror.connectWifi",
          "when": "view == deviceMirror.devices"
        }
      ],
      "view/item/context": [
        {
          "command": "deviceMirror.start",
          "when": "view == deviceMirror.devices && viewItem =~ /^device-ready/",
          "group": "inline@1"
        },
        {
          "command": "deviceMirror.stop",
          "when": "view == deviceMirror.devices && viewItem =~ /mirroring/",
          "group": "inline@2"
        },
        {
          "command": "deviceMirror.start",
          "when": "view == deviceMirror.devices && viewItem =~ /^device-ready/",
          "group": "1_mirror@1"
        },
        {
          "command": "deviceMirror.screenshot",
          "when": "view == deviceMirror.devices && viewItem =~ /^device-ready/",
          "group": "2_capture@1"
        },
        {
          "command": "deviceMirror.toggleRecording",
          "when": "view == deviceMirror.devices && viewItem =~ /^device-ready/",
          "group": "2_capture@2"
        },
        {
          "command": "deviceMirror.installApk",
          "when": "view == deviceMirror.devices && viewItem =~ /^device-ready/",
          "group": "3_files@1"
        },
        {
          "command": "deviceMirror.pushFile",
          "when": "view == deviceMirror.devices && viewItem =~ /^device-ready/",
          "group": "3_files@2"
        },
        {
          "command": "deviceMirror.switchToWifi",
          "when": "view == deviceMirror.devices && viewItem =~ /^device-ready.*-usb/",
          "group": "4_connection@1"
        }
      ],
      "explorer/context": [
        {
          "command": "deviceMirror.installApk",
          "when": "resourceExtname == .apk",
          "group": "7_deviceMirror@1"
        },
        {
          "command": "deviceMirror.pushFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_deviceMirror@2"
        }
      ],
      "editor/title": [
        {
          "command": "deviceMirror.screenshot",
          "when": "activeWebviewPanelId == deviceMirror",
          "group": "navigation@1"
        },
        {
          "command": "deviceMirror.toggleRecording",
          "when": "activeWebviewPanelId == deviceMirror",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/*.test.js\"",
    "fetch-server": "node scripts/fetch-server.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.84.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.2"
  },
  "keywords": [
    "android",
    "adb",
    "scrcpy",
    "mirror",
    "device",
    "emulator",
    "screen"
  ],
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/joyal670/vscode-device-mirror.git"
  },
  "bugs": {
    "url": "https://github.com/joyal670/vscode-device-mirror/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1E2A3A",
    "theme": "dark"
  },
  "homepage": "https://github.com/joyal670/vscode-device-mirror#readme"
}
